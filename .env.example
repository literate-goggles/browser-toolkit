OPENAI_API_KEY=

# Optional provider-model overrides
OPENAI_TEXT_MODEL=gpt-5.6-sol
OPENAI_TEXT_REASONING_EFFORT=low
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe
OPENAI_AUDIO_MODEL=gpt-audio-1.5

# Daily digest calendar boundary (IANA timezone)
DAILY_TIMEZONE=UTC

# Optional SQLite path for daily focus-timer history
DAILY_TIMERS_DB_FILE=api/daily_timers.sqlite3

# Public Chess.com account used for daily opening drills
CHESS_COM_USERNAME=unlimited_bezdarnost

# Optional checked-in repertoire override
CHESS_REPERTOIRE_FILE=api/chess_repertoire.json
